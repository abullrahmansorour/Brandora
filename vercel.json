{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/icon", "destination": "/assets/images/icon.png" },
    { "source": "/opengraph-image", "destination": "/assets/images/opengraph.png" }
  ]
}
